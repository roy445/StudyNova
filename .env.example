# ---------- Core ----------
# Neon pooled connection string; keep sslmode=require
DATABASE_URL=postgresql://<neon-user>:<password>@<neon-host>/<database>?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=https://your-domain.example
NODE_ENV=production

# ---------- Optional integrations ----------
REDIS_URL=

# ---------- Gemini API keys (priority 1 -> 5; rotate on retryable failure) ----------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.6-flash
# Legacy alias supported for API 1 compatibility:
GOOGLE_GEMINI_API_KEY=

# ---------- Other AI providers (optional fallback; leave blank for Gemini-only) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------- Object storage (optional; falls back to Neon PostgreSQL bytea storage) ----------
# Required for large browser-to-Blob direct uploads; keep this token server-side only.
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=15728640

# ---------- Azure Speech TTS (managed, no GPU worker; keep credentials server-only) ----------
# When both are set, new StudyNova TTS jobs automatically use Azure Speech.
# Choose the Azure Speech F0 (Free) pricing tier. Current published allowance: 500k Neural chars/month.
AZURE_SPEECH_KEY=
# Example region: eastasia (must match the Speech resource region)
AZURE_SPEECH_REGION=

# ---------- Optional self-hosted TTS worker fallback (CosyVoice / GPT-SoVITS) ----------
# TTS_SERVICE_URL is the HTTPS base URL (without /v1/tts); keep the bearer token server-only.
# The worker must expose POST /v1/tts and return
# { "audioBase64": "...", "mimeType": "audio/wav", "durationMs": 1234 }.
TTS_SERVICE_URL=
TTS_SERVICE_TOKEN=
# Optional per-segment timeout, 5000–300000 ms (default 120000).
TTS_REQUEST_TIMEOUT_MS=120000

# ---------- Web Push ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studynova.ai

# ---------- Cron (optional; required for external scheduled jobs) ----------
CRON_SECRET=replace-with-a-long-random-cron-secret

# ---------- Admin roles ----------
# New registrations are always student. Grant admin/owner with database/admin-role.sql in Neon.

# ---------- Gmail SMTP (use a Google 16-character app password; never use your Gmail login password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
