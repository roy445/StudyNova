# ---------- Core ----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Cache / Queue (optional, falls back to PostgreSQL queue adapter) ----------
REDIS_URL=

# ---------- AI Providers (priority 1 -> 3) ----------
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------- Object storage (optional, falls back to PostgreSQL storage driver) ----------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=15728640

# ---------- Web Push ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studynova.ai

# ---------- Cron ----------
CRON_SECRET=change-me-cron-secret

# ---------- Optional bootstrap owner (created on first boot only) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=StudyNova Owner

# ---------- Optional SMTP (when set, password reset links are not returned in the API) ----------
SMTP_URL=
