# ---------- Core ----------
# Neon pooled connection string; keep sslmode=require
DATABASE_URL=postgresql://<neon-user>:<password>@<neon-host>/<database>?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=https://your-domain.example
NODE_ENV=production

# ---------- Cache / Queue (optional; omit when using Neon-only setup) ----------
REDIS_URL=

# ---------- Gemini API keys (priority 1 -> 3; rotate on retryable failure) ----------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.6-flash
# Legacy alias supported for API 1 compatibility:
GOOGLE_GEMINI_API_KEY=

# ---------- Other AI providers (optional fallback; leave blank for Gemini-only) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------- Object storage (optional; falls back to Neon PostgreSQL bytea storage) ----------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=15728640

# ---------- Web Push ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studynova.ai

# ---------- Cron (optional; required for external scheduled jobs) ----------
CRON_SECRET=replace-with-a-long-random-cron-secret

# ---------- Admin roles ----------
# New registrations are always student. Grant admin/owner with database/admin-role.sql in Neon.

# ---------- Optional SMTP (when set, password reset links are not returned in the API) ----------
SMTP_URL=
