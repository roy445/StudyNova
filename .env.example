# ---------- Core ----------
# Neon pooled connection string; keep sslmode=require
DATABASE_URL=postgresql://<neon-user>:<password>@<neon-host>/<database>?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=https://your-domain.example
NODE_ENV=production

# ---------- Optional integrations ----------
REDIS_URL=

# ---------- Gemini API keys (priority 1 -> 5; rotate on retryable failure) ----------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.6-flash
# Legacy alias supported for API 1 compatibility:
GOOGLE_GEMINI_API_KEY=

# ---------- NVIDIA hosted AI (optional; OpenAI-compatible Chat Completions) ----------
# NVIDIA Build 免費原型方案有 RPM／帳戶限制，不是無限制免費。
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ---------- Other AI providers (optional fallback; leave blank for Gemini-only) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional self-hosted Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# ---------- Object storage (optional; falls back to Neon PostgreSQL bytea storage) ----------
# Required for large browser-to-Blob direct uploads; keep this token server-side only.
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=15728640

# ---------- Speech ----------
# StudyNova uses browser/device speech synthesis. No TTS API key, worker, cron, or audio storage is required.

# ---------- Web Push ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studynova.ai

# ---------- Cron (optional; required for external scheduled jobs) ----------
CRON_SECRET=replace-with-a-long-random-cron-secret

# ---------- Admin roles ----------
# New registrations are always student. Grant admin/owner with database/admin-role.sql in Neon.

# ---------- Gmail SMTP (use a Google 16-character app password; never use your Gmail login password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
